<Application
    x:Class="VabelMitienditaEsc.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="clr-namespace:VabelMitienditaEsc.ViewModels"
    xmlns:views="clr-namespace:VabelMitienditaEsc.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Fonts.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type viewmodels:LoginEmailViewModel}">
                <views:LoginEmailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:LoginPinViewModel}">
                <views:LoginPinView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:LobbyViewModel}">
                <views:LobbyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:LibretaVentasViewModel}">
                <views:LibretaVentasView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:NuevaVentaViewModel}">
                <views:NuevaVentaView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:GastoViewModel}">
                <views:GastoView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ProveedorViewModel}">
                <views:ProveedorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:InventarioViewModel}">
                <views:InventarioView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:DetalleProductoViewModel}">
                <views:DetalleProductoView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>