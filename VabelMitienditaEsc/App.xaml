<Application x:Class="VabelMitienditaEsc.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:VabelMitienditaEsc.Views"
             xmlns:viewmodels="clr-namespace:VabelMitienditaEsc.ViewModels"
             xmlns:core="clr-namespace:VabelMitienditaEsc.Core">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Fonts.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <core:BoolToTextConverter x:Key="BoolToTextConverter"/>
            <core:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <DataTemplate DataType="{x:Type viewmodels:LoginEmailViewModel}">
                <views:LoginEmailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:LoginPinViewModel}">
                <views:LoginPinView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:LobbyViewModel}">
                <views:LobbyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:GastoViewModel}">
                <views:GastoView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>