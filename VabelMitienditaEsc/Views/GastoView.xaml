<UserControl x:Class="VabelMitienditaEsc.Views.GastoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:VabelMitienditaEsc.Views"
             xmlns:core="clr-namespace:VabelMitienditaEsc.Core" 
             mc:Ignorable="d"
             Background="{StaticResource BrushBackgroundWhite}"
             d:DesignHeight="720"
             d:DesignWidth="1080">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <core:BoolToTextConverter x:Key="BoolToTextConverter" />
        <core:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="2"
                                      Color="#000000"
                                      Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#D5DBDB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#D5DBDB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ModernDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Gastos Operativos"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimaryBlue}"/>

                <TextBlock Text="Gestión y control de gastos registrados"
                           Foreground="#7F8C8D"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="+ Buscar Gasto"
                    Style="{StaticResource RoundedButtonStyle}"
                    Background="{StaticResource BrushPrimaryBlue}"
                    Command="{Binding AbrirFormularioNuevoGastoCommand}"
                    VerticalAlignment="Center"/>

        </Grid>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Formulario -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="{Binding EsEdicion, Converter={StaticResource BoolToTextConverter}}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushPrimaryBlue}"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Fecha:"
                                   Style="{StaticResource LabelStyle}"/>

                        <DatePicker SelectedDate="{Binding FechaGasto}"
                                    Style="{StaticResource ModernDatePickerStyle}"/>

                        <TextBlock Text="Descripción:"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding DescripcionGasto}"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 Style="{StaticResource ModernTextBoxStyle}"/>

                        <TextBlock Text="Monto ($):"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding MontoGasto}"
                                 Style="{StaticResource ModernTextBoxStyle}"/>

                        <TextBlock Text="Tasa IVA (%):"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding TasaIVAGasto}"
                                 Style="{StaticResource ModernTextBoxStyle}"/>

                        <TextBlock Text="Observaciones:"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding ObservacionesGasto}"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 Style="{StaticResource ModernTextBoxStyle}"/>

                        <TextBlock Text="Proveedor:"
                                   Style="{StaticResource LabelStyle}"/>

                        <ComboBox ItemsSource="{Binding ListaProveedores}"
                                  SelectedValuePath="idProveedor"
                                  DisplayMemberPath="nombreEmpresa"
                                  SelectedValue="{Binding ProveedorSeleccionado}"
                                  Style="{StaticResource ModernComboBoxStyle}"/>

                        <TextBlock Text="Cuenta:"
                                   Style="{StaticResource LabelStyle}"/>

                        <ComboBox ItemsSource="{Binding ListaCatalogoCuentas}"
                                  SelectedValuePath="idCuenta"
                                  DisplayMemberPath="nombreCuenta"
                                  SelectedValue="{Binding CuentaSeleccionada}"
                                  Style="{StaticResource ModernComboBoxStyle}"/>

                        <TextBlock Text="Forma de Pago:"
                                   Style="{StaticResource LabelStyle}"/>

                        <ComboBox ItemsSource="{Binding ListaFormasPago}"
                                  SelectedValuePath="idFormaPago"
                                  DisplayMemberPath="nombre"
                                  SelectedValue="{Binding FormaPagoSeleccionada}"
                                  Style="{StaticResource ModernComboBoxStyle}"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,0">

                            <Button Content="Guardar"
                                    Command="{Binding GuardarGastoCommand}"
                                    Style="{StaticResource RoundedButtonStyle}"
                                    Background="{StaticResource BrushGreen}"
                                    Margin="0,0,10,0"/>

                            <Button Content="Cancelar"
                                    Command="{Binding CancelarEdicionCommand}"
                                    Style="{StaticResource RoundedButtonStyle}"
                                    Background="#7F8C8D"/>

                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- Listado al buscar -->
            <StackPanel Grid.Column="2"
                        Visibility="{Binding MostrarListadoGastos, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Border Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Filtros de búsqueda"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#34495E"
                                   Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal">

                            <StackPanel Margin="0,0,15,0">

                                <TextBlock Text="Desde"
                                           Style="{StaticResource LabelStyle}"/>

                                <DatePicker SelectedDate="{Binding FechaInicio}"
                                            Width="140"/>

                            </StackPanel>

                            <StackPanel Margin="0,0,15,0">

                                <TextBlock Text="Hasta"
                                           Style="{StaticResource LabelStyle}"/>

                                <DatePicker SelectedDate="{Binding FechaFin}"
                                            Width="140"/>

                            </StackPanel>

                            <Button Content="Buscar"
                                    Command="{Binding BuscarPorFechasCommand}"
                                    Style="{StaticResource RoundedButtonStyle}"
                                    Background="{StaticResource BrushPrimaryBlue}"
                                    VerticalAlignment="Bottom"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

                <!-- Total -->
                <Border Style="{StaticResource CardStyle}"
                        Background="#FFF5F5">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Monto Total:"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding MontoTotal, StringFormat='${0:N2}'}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushRed}"
                                   Margin="15,0,0,0"/>

                    </StackPanel>

                </Border>

                <Border Style="{StaticResource CardStyle}">

                    <Grid>

                        <DataGrid ItemsSource="{Binding ListaGastosOperativos}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Background="White"
                                  BorderThickness="0"
                                  RowHeight="40"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#ECF0F1"
                                  VerticalGridLinesBrush="Transparent">

                            <DataGrid.ColumnHeaderStyle>

                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="Background" Value="#F8F9F9"/>
                                    <Setter Property="Foreground" Value="#34495E"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="BorderThickness" Value="0"/>

                                </Style>

                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Fecha"
                                                    Binding="{Binding fecha, StringFormat='dd/MM/yyyy'}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Descripción"
                                                    Binding="{Binding descripcion}"
                                                    Width="180"/>

                                <DataGridTextColumn Header="Monto"
                                                    Binding="{Binding monto, StringFormat='${0:N2}'}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Usuario"
                                                    Binding="{Binding nomUsuario}"
                                                    Width="150"/>

                                <DataGridTextColumn Header="Proveedor"
                                                    Binding="{Binding nombreEmpresaProveedor}"
                                                    Width="140"/>

                                <DataGridTextColumn Header="Forma Pago"
                                                    Binding="{Binding formaPago}"
                                                    Width="120"/>

                                <DataGridTemplateColumn Header="Acciones"
                                                        Width="100">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Button Content="Editar"
                                                    Command="{Binding DataContext.EditarGastoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RoundedButtonStyle}"
                                                    Background="{StaticResource BrushYellow}"
                                                    FontSize="12"
                                                    Padding="10,5"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

                <TextBlock Text="No hay gastos registrados en este período"
                           Foreground="#95A5A6"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"
                           Visibility="{Binding ListaGastosOperativos.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>