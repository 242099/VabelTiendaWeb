<UserControl
    x:Class="VabelMitienditaEsc.Views.LobbyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VabelMitienditaEsc.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1080"
    Background="{StaticResource BrushBackgroundWhite}"
    mc:Ignorable="d">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,20"
            Padding="20"
            Background="{StaticResource BrushBackgroundWhite}"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Opacity="0.05"
                    ShadowDepth="1"
                    Color="#000000" />
            </Border.Effect>
            <Grid>
                <StackPanel>
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="{StaticResource BrushPrimaryBlue}"
                        Text="{Binding WelcomeMessage}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="18"
                        Foreground="#7F8C8D"
                        Text="Este es el sistema Vabel para gestionar tu tiendita. Seleccione una operación en el menú lateral para comenzar."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" />
    </Grid>
</UserControl>
