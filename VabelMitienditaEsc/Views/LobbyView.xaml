<UserControl x:Class="VabelMitienditaEsc.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:VabelMitienditaEsc.ViewModels"
             xmlns:converters="clr-namespace:VabelMitienditaEsc.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1080"
             Background="{StaticResource BrushBackgroundWhite}"
             d:DataContext="{d:DesignInstance Type=viewmodels:LobbyViewModel}">
    
<UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="BorderBrush" Value="#E5E8E8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#7F8C8D"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,10,0,2"/>
    </Style>

    <Style x:Key="ValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#2C3E50"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</UserControl.Resources>

<Grid Margin="40,30,40,30">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FED7D7" BorderBrush="#F56565" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20"
                Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}">
        <TextBlock Text="{Binding MensajeError}" Foreground="#C53030" FontWeight="Bold"/>
    </Border>

    <StackPanel Grid.Row="1" Margin="0,0,0,30">
        <TextBlock Text="¡Hola de nuevo!" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}"/>
        <TextBlock Text="{Binding NombreCompleto, StringFormat='Bienvenido a Vabel, {0}'}" 
                       FontSize="18" Foreground="{StaticResource BrushPrimaryBlue}" Margin="0,5,0,0"/>
    </StackPanel>

    <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="4" Width="200" 
                     Foreground="{StaticResource BrushPrimaryBlue}" Background="#E2E8F0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                     VerticalAlignment="Top"/>

    <Grid Grid.Row="2" Margin="0,20,0,0">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Style="{StaticResource IconStyle}" Text="&#xe7fd;" Foreground="{StaticResource BrushPrimaryBlue}" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Tu Perfil" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}" VerticalAlignment="Center"/>
                </StackPanel>
                <Separator Margin="0,0,0,15" Background="#E5E8E8"/>

                <TextBlock Text="Puesto / Rol" Style="{StaticResource LabelStyle}"/>
                <Border Background="#EBF4FF" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,12">
                    <TextBlock Text="{Binding UsuarioActual.NombreRol}" Foreground="#3182CE" FontWeight="Bold"/>
                </Border>

                <TextBlock Text="Correo Electrónico" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding UsuarioActual.Email}" Style="{StaticResource ValueStyle}" Margin="0,0,0,10"/>

                <TextBlock Text="RFC" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding UsuarioActual.RFC, TargetNullValue='No registrado', FallbackValue='No registrado'}" Style="{StaticResource ValueStyle}" Margin="0,0,0,10"/>

                <TextBlock Text="CURP" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding UsuarioActual.CURP, TargetNullValue='No registrado', FallbackValue='No registrado'}" Style="{StaticResource ValueStyle}"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Style="{StaticResource IconStyle}" Text="&#xe8d1;" Foreground="{StaticResource BrushPrimaryBlue}" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Tu Tienda" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}" VerticalAlignment="Center"/>
                </StackPanel>
                <Separator Margin="0,0,0,15" Background="#E5E8E8"/>

                <TextBlock Text="Nombre del Negocio" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding TiendaActual.Nombre}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}" Margin="0,0,0,12"/>

                <TextBlock Text="Dirección" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding TiendaActual.Direccion}" Style="{StaticResource ValueStyle}" Margin="0,0,0,10"/>

                <TextBlock Text="Teléfono" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding TiendaActual.Telefono, TargetNullValue='No registrado', FallbackValue='No registrado'}" Style="{StaticResource ValueStyle}" Margin="0,0,0,10"/>

                <TextBlock Text="Estado Operativo" Style="{StaticResource LabelStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse Width="12" Height="12" Fill="{Binding TiendaActual.Activa, Converter={StaticResource BoolToColorConverter}}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TiendaActual.Activa, Converter={StaticResource BoolToStatusConverter}}" Style="{StaticResource ValueStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
