<UserControl x:Class="VabelMitienditaEsc.Views.ProveedorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:VabelMitienditaEsc.Views"
             xmlns:core="clr-namespace:VabelMitienditaEsc.Core"
             mc:Ignorable="d"
             Background="{StaticResource BrushBackgroundWhite}"
             d:DesignHeight="720"
             d:DesignWidth="1080">
    
    
    
    <UserControl.Resources>
        <core:BoolToTextConverter x:Key="BoolToTextConverter"/>
        <core:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushPrimaryBlue}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushPrimaryBlue}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,30,40,30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1.3*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Lista de Proveedores" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}" Margin="0,0,0,20"/>

            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding CriterioBusqueda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Height="40" Style="{StaticResource RoundedTextBoxStyle}" Margin="0,0,10,0"/>

                <Button Grid.Column="1" Command="{Binding BuscarProveedoresCommand}"
                        Background="{StaticResource BrushPrimaryBlue}" Foreground="White"
                        Height="40" Margin="0,0,10,0" Cursor="Hand" Padding="20,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0">
                                    <TextBlock Style="{StaticResource IconStyle}" Text="&#xe8b6;" FontSize="18" Margin="0,0,5,0" Foreground="White"/>
                                    <TextBlock Text="Buscar" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Command="{Binding LimpiarBusquedaCommand}"
                        Background="{StaticResource BrushYellow}" Foreground="White"
                        Height="40" Margin="0,0,10,0" Cursor="Hand" Padding="20,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0">
                                    <TextBlock Style="{StaticResource IconStyle}" Text="&#xe5d5;" FontSize="18" Margin="0,0,5,0" Foreground="White"/>
                                    <TextBlock Text="Limpiar" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="3" Command="{Binding AbrirFormularioNuevoProveedorCommand}"
                        Background="{StaticResource BrushGreen}" Foreground="White"
                        Height="40" Cursor="Hand" Padding="20,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0">
                                    <TextBlock Style="{StaticResource IconStyle}" Text="&#xe145;" FontSize="18" Margin="0,0,5,0" Foreground="White"/>
                                    <TextBlock Text="Nuevo" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock Grid.Row="2" Text="No hay proveedores registrados"
                       Foreground="#95A5A6" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                       Visibility="{Binding ListaProveedores.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ListaProveedores}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderThickness="1" BorderBrush="#E5E8E8" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#EBF5FB" Margin="0,0,15,0">
                                        <TextBlock Style="{StaticResource IconStyle}" Text="&#xe7fb;" Foreground="{StaticResource BrushPrimaryBlue}" FontSize="24"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding nombreCompleto}" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="ID: " FontSize="13" Foreground="#95A5A6"/>
                                            <TextBlock Text="{Binding idProveedor}" FontSize="13" Foreground="#95A5A6" FontWeight="Medium" Margin="0,0,8,0"/>
                                            <TextBlock Text="•" FontSize="13" Foreground="#BDC3C7" Margin="0,0,8,0"/>
                                            <TextBlock Text="Empresa: " FontSize="13" Foreground="#95A5A6"/>
                                            <TextBlock Text="{Binding nombreEmpresa, FallbackValue='-'}" FontSize="13" Foreground="#7F8C8D" FontWeight="Medium"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconStyle}" Text="&#xe0cd;" Foreground="{StaticResource BrushPrimaryBlue}" FontSize="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding telefono}" Foreground="#34495E" FontSize="13" Margin="0,0,12,0"/>
                                            <TextBlock Style="{StaticResource IconStyle}" Text="&#xe158;" Foreground="#95A5A6" FontSize="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding email}" Foreground="#7F8C8D" FontStyle="Italic" FontSize="13"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.EditarProveedorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Background="{StaticResource BrushYellow}" Foreground="White" Width="36" Height="36" Margin="0,0,8,0" Cursor="Hand" ToolTip="Editar">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <TextBlock Style="{StaticResource IconStyle}" Text="&#xe3c9;" FontSize="18"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Command="{Binding DataContext.EliminarProveedorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Background="{StaticResource BrushRed}" Foreground="White" Width="36" Height="36" Cursor="Hand" ToolTip="Eliminar">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <TextBlock Style="{StaticResource IconStyle}" Text="&#xe872;" FontSize="18"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="25"
                Visibility="{Binding MostrarFormularioProveedor, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#000000" Opacity="0.04"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding EsEdicion, Converter={StaticResource BoolToTextConverter}}"
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}" Margin="0,0,0,20"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Datos de la Empresa" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}" Margin="0,0,0,10"/>
                        <TextBlock Text="Nombre de la empresa:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding NombreEmpresa, Mode=TwoWay}" Style="{StaticResource RoundedTextBoxStyle}" />

                        <TextBlock Text="RFC:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding RfcEmpresa, Mode=TwoWay}" Style="{StaticResource RoundedTextBoxStyle}" />

                        <TextBlock Text="Datos del Proveedor" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}" Margin="0,10,0,10"/>
                        <TextBlock Text="Nombre(s):" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding NombreProveedor, Mode=TwoWay}" Style="{StaticResource RoundedTextBoxStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Apellido Paterno:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding ApellidoPaternoProveedor, Mode=TwoWay}" Style="{StaticResource RoundedTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Apellido Materno:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding ApellidoMaternoProveedor, Mode=TwoWay}" Style="{StaticResource RoundedTextBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Teléfono:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding TelefonoProveedor, Mode=TwoWay}" Style="{StaticResource RoundedTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Fecha de registro:" Style="{StaticResource FormLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding FechaRegistroProveedor, Mode=TwoWay}" Margin="0,0,0,15" FontSize="14">
                                    <DatePicker.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Correo Electrónico:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EmailProveedor, Mode=TwoWay}" Style="{StaticResource RoundedTextBoxStyle}" />

                        <TextBlock Text="Domicilio de la Empresa" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}" Margin="0,10,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Calle:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding CalleEmpresa, Mode=TwoWay}" Style="{StaticResource RoundedTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Número:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NumeroEmpresa, Mode=TwoWay}" Style="{StaticResource RoundedTextBoxStyle}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Ciudad:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding CiudadEmpresa, Mode=TwoWay}" Style="{StaticResource RoundedTextBoxStyle}" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding CancelarProveedorCommand}"
                            Background="#95A5A6" Foreground="White" Padding="0,12" Margin="0,0,10,0" Cursor="Hand" Height="35">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconStyle}" Text="&#xe5c9;" FontSize="18" Margin="0,0,5,0" Foreground="White"/>
                            <TextBlock Text="Cancelar" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Command="{Binding GuardarProveedorCommand}"
                            Background="{StaticResource BrushGreen}" Foreground="White" Padding="0,12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconStyle}" Text="&#xe161;" FontSize="18" Margin="0,0,5,0" Foreground="White"/>
                            <TextBlock Text="Guardar" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>