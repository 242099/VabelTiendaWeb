<UserControl x:Class="VabelMitienditaEsc.Views.LoginPinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VabelMitienditaEsc.Views"
             mc:Ignorable="d"
             Background="{StaticResource BrushBackgroundWhite}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <Image Source="/Res/Images/vabel_dark.png" Height="80" Width="Auto" Margin="0,0,0,10" />
            <TextBlock Text="Vabel" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Ingresa tu PIN" Foreground="{StaticResource BrushPrimaryBlue}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5" />
            <PasswordBox x:Name="PinBox" Height="40" Padding="10" FontSize="16" Margin="0,0,0,20" MaxLength="4"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushRed}" Margin="0,0,0,10" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap"/>

            <Button Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=PinBox}" 
                    Content="Entrar" Background="{StaticResource BrushGreen}" Foreground="White" 
                    Height="45" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

            <Button Command="{Binding BackCommand}" Content="Regresar" FontSize="16"
                    Background="Transparent" Foreground="{StaticResource BrushPrimaryBlue}" 
                    Height="40" Margin="0,10,0,0" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>
