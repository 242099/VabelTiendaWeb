<UserControl x:Class="VabelMitienditaEsc.Views.NuevaVentaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:VabelMitienditaEsc.ViewModels"
             xmlns:models="clr-namespace:VabelMitienditaEsc.Models"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1080"
             d:DataContext="{d:DesignInstance Type=viewmodels:NuevaVentaViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrushPrimaryBlue}" Padding="20,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Vabel" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="3*" MinWidth="340" MaxWidth="420"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Nueva venta" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}" Margin="0,0,0,12"/>

                <Border Grid.Row="1" Background="White" CornerRadius="20" Height="42" Padding="15,0" Margin="0,0,0,15" BorderBrush="#CCCCCC" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="txtBusqueda" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     VerticalAlignment="Center" 
                                     FontSize="15" 
                                     Foreground="#333333"
                                     Text="{Binding FiltroBusqueda, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock IsHitTestVisible="False" 
                                       Text="Buscar producto ..." 
                                       VerticalAlignment="Center" 
                                       Foreground="#777777" 
                                       FontSize="15"
                                       Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtBusqueda}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Grid.Column="1" Style="{StaticResource IconStyle}" Text="&#xe8b6;" Foreground="{StaticResource BrushPrimaryBlue}" FontSize="20" Margin="0,0,10,0"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ProductosCatalogo}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="10" Padding="15,10" Margin="0,0,0,8" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="15" Foreground="#333333"/>
                                            <TextBlock Text="{Binding CodigoBarra, StringFormat='Código: {0}'}" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PrecioVenta, StringFormat={}{0:C}}" FontSize="16" FontWeight="Bold" Foreground="#1086a0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StockActual, StringFormat='Stock: {0}'}" FontSize="13" Foreground="#666666"/>
                                        </StackPanel>

                                        <Button Grid.Column="3" Width="36" Height="36" Background="#d43c2f" 
                                                BorderBrush="Transparent" Margin="5,0" Cursor="Hand"
                                                Command="{Binding DataContext.QuitarDelCarritoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="-" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                        </Button>

                                        <Button Grid.Column="4" Width="36" Height="36" Background="#3ba151" 
                                                BorderBrush="Transparent" Margin="5,0" Cursor="Hand"
                                                Command="{Binding DataContext.AgregarAlCarritoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="+" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="15" Background="#F9F9F9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushPrimaryBlue}" CornerRadius="14,14,0,0">
                        <TextBlock Text="RESUMEN DEL PEDIDO" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="12"/>
                    </Border>

                    <ListBox Grid.Row="1" BorderThickness="0" Padding="8" 
                             Background="Transparent" HorizontalContentAlignment="Stretch"
                             ItemsSource="{Binding ProductosCarrito}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,5" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="{Binding CantidadCarrito, StringFormat='Cantidad: {0}'}" FontSize="11" Foreground="#666"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding SubtotalCarrito, StringFormat={}{0:C}}" 
                                                   FontWeight="Bold" FontSize="14" Foreground="#1086a0" 
                                                   VerticalAlignment="Center" Margin="10,0"/>

                                        <Button Grid.Column="2" Content="✕" Background="Transparent" 
                                                Foreground="#E74C3C" BorderThickness="0" FontSize="14" FontWeight="Bold"
                                                Cursor="Hand" Margin="5,0"
                                                Command="{Binding DataContext.EliminarItemCarritoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Background="#F0F0F0" CornerRadius="0,0,14,14" Padding="15,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding TotalProductosCarrito, StringFormat='{}{0} productos seleccionados'}" 
                                           FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="{Binding Total, StringFormat='Total: {0:C}'}" 
                                           FontSize="20" FontWeight="Bold" Foreground="Black"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Confirmar" 
                                    Background="#489fb5" BorderBrush="#489fb5"             
                                    Foreground="White" Width="105" Height="40" 
                                    FontWeight="Bold" FontSize="14" Cursor="Hand"
                                    Command="{Binding CobrarVentaCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="18"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
