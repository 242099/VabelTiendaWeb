<UserControl x:Class="VabelMitienditaEsc.Views.DetalleProductoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VabelMitienditaEsc.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1080"
             Background="{StaticResource BrushBackgroundWhite}">
    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditableTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushPrimaryBlue}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid x:Name="GridPrincipal">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <!-- Barra azul con logo y título -->
                    <Border Background="{StaticResource BrushPrimaryBlue}" CornerRadius="0" Padding="20,15" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding NavigateToInventarioCommand}" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Style="{StaticResource ActionButtonStyle}" 
                                    Padding="0" 
                                    Margin="0,0,10,0"
                                    Cursor="Hand">
                                <TextBlock Style="{StaticResource IconStyle}" Text="&#xe5c4;" Foreground="White" FontSize="24"/>
                            </Button>
                            <TextBlock Text="Inventario: Detalle del Producto" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- BUSCADOR DE PRODUCTOS -->
                    <Border Background="White" CornerRadius="15" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="BUSCAR PRODUCTO EXISTENTE PARA EDITAR" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="#1086a0" 
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox Text="{Binding BuscarTexto, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EditableTextBoxStyle}" 
                                             FontSize="14"
                                             ToolTip="Escriba nombre o código de barras"/>
                                    <TextBlock IsHitTestVisible="False" 
                                               Text="Buscar por NOMBRE o CODIGO DE BARRAS" 
                                               VerticalAlignment="Center" 
                                               Foreground="#888888" 
                                               FontSize="14"
                                               Margin="10,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=txtBuscarProducto}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="1" Command="{Binding BuscarProductoCommand}" 
        Background="{StaticResource BrushPrimaryBlue}" BorderBrush="{StaticResource BrushPrimaryBlue}"  Foreground="White" Margin="10,0,0,0" 
        Width="100" Height="38" Style="{StaticResource ActionButtonStyle}"
        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource IconStyle}" Text="&#xe1a1;" Foreground="White" FontSize="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="BUSCAR" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- RESULTADOS DE BÚSQUEDA -->
                    <Border Visibility="{Binding MostrarResultados, Converter={StaticResource BooleanToVisibilityConverter}}" Background="White" CornerRadius="10" Padding="0" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="▼ Productos encontrados (haz clic para seleccionar):" 
                   FontWeight="Bold" 
                   Margin="12,10,12,8" 
                   FontSize="13" 
                   Foreground="#1E293B"/>

                            <ListBox 
                 ItemsSource="{Binding ResultadosBusqueda}"
                 SelectedItem="{Binding ProductoSeleccionado, Mode=TwoWay}"
                 Height="130"
                 BorderThickness="0"
                 Background="#F8FAFC">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,12" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Columna izquierda: Nombre + Precio + Stock -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nombre}" 
                                           FontWeight="Bold" 
                                           FontSize="14" 
                                           Foreground="#0F172A"
                                           Margin="0,0,20,0"/>
                                                    <TextBlock Text="$" FontSize="12" Foreground="{StaticResource BrushPrimaryBlue}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding PrecioVenta}" 
                                           FontSize="12" 
                                           Foreground="{StaticResource BrushPrimaryBlue}" 
                                           FontWeight="Bold"
                                           Margin="2,0,0,0"/>
                                                    <TextBlock Text="|" FontSize="11" Foreground="#CBD5E1" Margin="16,0,0,0"/>
                                                    <TextBlock Text="Stock:" FontSize="13" Foreground="#64748B" Margin="10,0,0,0"/>
                                                    <TextBlock Text="{Binding StockActual}" 
                                           FontSize="13" 
                                           Foreground="#0F172A" 
                                           FontWeight="Bold"
                                           Margin="6,0,0,0"/>
                                                    <TextBlock Text="uds" FontSize="12" Foreground="#64748B" Margin="4,0,0,0"/>
                                                </StackPanel>

                                                <!-- Columna derecha: Códigos -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                                    <Border Background="#E2E8F0" CornerRadius="5" Padding="10,5">
                                                        <TextBlock Text="{Binding CodigoBarra, StringFormat='Cód: {0}'}" 
                                               FontSize="12" 
                                               Foreground="#1E293B"
                                               FontFamily="Consolas"
                                               FontWeight="Medium"/>
                                                    </Border>
                                                    <Border Background="#E2E8F0" CornerRadius="5" Padding="10,5" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding ProductoId, StringFormat='ID: {0}'}" 
                                               FontSize="12" 
                                               Foreground="#1E293B"
                                               FontFamily="Consolas"
                                               FontWeight="Medium"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Formulario del producto -->
                    <Border Background="White" CornerRadius="15" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Nombre del Producto" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditableTextBoxStyle}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                <TextBlock Text="Marca / Laboratorio" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditableTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="Código de Barras" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CodigoBarra, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditableTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Categoría -->
                    <Border Background="White" CornerRadius="15" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,10,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Categoría" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbCategoria" 
                                          ItemsSource="{Binding Categorias}"
                                          DisplayMemberPath="Nombre"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding CategoriaId, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          Height="38"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="CONFIGURACIÓN DE PRECIOS" FontSize="12" FontWeight="Bold" Foreground="#777777" Margin="0,0,0,8"/>

                        <Border Background="#0f4c5c" CornerRadius="12" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PRECIO DE VENTA (PVP):" FontSize="11" Foreground="#A5C4CC" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding PrecioVenta, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Background="#135d70" Foreground="White" BorderThickness="0" FontSize="20" FontWeight="Bold" Padding="4" CaretBrush="White"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="MXN" FontSize="14" Foreground="#A5C4CC" FontWeight="Bold" VerticalAlignment="Bottom" Margin="5,0,0,6"/>
                            </Grid>
                        </Border>

                        <Border Background="#0f4c5c" CornerRadius="12" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PRECIO COSTO PROVEEDOR:" FontSize="11" Foreground="#A5C4CC" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding PrecioCosto, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Background="#135d70" Foreground="White" BorderThickness="0" FontSize="20" FontWeight="Bold" Padding="4" CaretBrush="White"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="MXN" FontSize="14" Foreground="#A5C4CC" FontWeight="Bold" VerticalAlignment="Bottom" Margin="5,0,0,6"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="15,18,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ANÁLISIS DE GANANCIA (CALCULADO)" FontSize="12" FontWeight="Bold" Foreground="#0f4c5c" Margin="0,0,0,10"/>

                            <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                                <StackPanel Margin="5">
                                    <TextBlock Text="Porcentaje de Margen" FontSize="11" Foreground="#777777"/>
                                    <TextBlock Text="{Binding PorcentajeGanancia, StringFormat='{}{0:F1}%'}" FontSize="18" FontWeight="Bold" Foreground="#1086a0"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="Monto de Utilidad" FontSize="11" Foreground="#777777"/>
                                    <TextBlock Text="{Binding MontoUtilidad, StringFormat={}{0:C}}" FontSize="18" FontWeight="Bold" Foreground="#1086a0"/>
                                </StackPanel>
                                <StackPanel Margin="5" Grid.ColumnSpan="2">
                                    <TextBlock Text="Utilidad Total Estimada" FontSize="11" Foreground="#777777"/>
                                    <TextBlock Text="{Binding UtilidadTotalEstimada, StringFormat={}{0:C}}" FontSize="14" FontWeight="Bold" Foreground="#1086a0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <TextBlock Text="LOGÍSTICA Y CONTROL DE STOCK" FontSize="12" FontWeight="Bold" Foreground="#777777" Margin="0,0,0,5"/>
                    <UniformGrid Columns="3">
                        <!-- CANTIDAD ACTUAL EN ALMACÉN -->
                        <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CANTIDAD ACTUAL EN ALMACÉN" FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding StockActual, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditableTextBoxStyle}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="Uds" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#64748B" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- STOCK MÍNIMO (ALERTA) -->
                        <Border Background="White" CornerRadius="12" Padding="15" Margin="5,0,5,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="STOCK MÍNIMO (ALERTA)" FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditableTextBoxStyle}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="Uds" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#64748B" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ESTADO DE REABASTECIMIENTO CON 3 NIVELES -->
                        <Border CornerRadius="12" Padding="15" Margin="10,0,0,0" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NivelStockActual}" Value="Optimo">
                                            <Setter Property="Background" Value="#F0FFF0"/>
                                            <Setter Property="BorderBrush" Value="#C6F6D5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NivelStockActual}" Value="Advertencia">
                                            <Setter Property="Background" Value="#FFF8E1"/>
                                            <Setter Property="BorderBrush" Value="#FFE082"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NivelStockActual}" Value="Critico">
                                            <Setter Property="Background" Value="#FFF0F0"/>
                                            <Setter Property="BorderBrush" Value="#FEB2B2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SinProductoSeleccionado}" Value="True">
                                            <Setter Property="Background" Value="#F0F0F0"/>
                                            <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ESTADO DE REABASTECIMIENTO" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#888888"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NivelStockActual}" Value="Optimo">
                                                    <Setter Property="Foreground" Value="#276749"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NivelStockActual}" Value="Advertencia">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushRed}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NivelStockActual}" Value="Critico">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushRed}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SinProductoSeleccionado}" Value="True">
                                                    <Setter Property="Foreground" Value="#888888"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding EstadoReabastecimiento}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#888888"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NivelStockActual}" Value="Optimo">
                                                    <Setter Property="Foreground" Value="#276749"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NivelStockActual}" Value="Advertencia">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushRed}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NivelStockActual}" Value="Critico">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushRed}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SinProductoSeleccionado}" Value="True">
                                                    <Setter Property="Foreground" Value="#888888"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="DESCRIPCIÓN DEL PRODUCTO" FontSize="13" FontWeight="Bold" Foreground="#0f4c5c" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditableTextBoxStyle}" TextWrapping="Wrap" Height="80"/>
                            <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#64748B"
                                       Text="{Binding ProductoId, StringFormat='ID Producto: {0}'}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="15,0,0,0">
                        <Button Content="LIMPIAR CAMPOS" Command="{Binding LimpiarCamposCommand}" Background="{StaticResource BrushYellow}" Foreground="White" BorderBrush="{StaticResource BrushYellow}"  FontSize="15" FontWeight="Bold" Height="45" Margin="0,0,0,10" Cursor="Hand" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="GUARDAR CAMBIOS" Command="{Binding GuardarCambiosCommand}" Background="{StaticResource BrushGreen}" Foreground="White" BorderBrush="{StaticResource BrushGreen}" FontSize="15" FontWeight="Bold" Height="45" Margin="0,0,0,10" Cursor="Hand" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="ELIMINAR PRODUCTO" Command="{Binding EliminarProductoCommand}" Background="Transparent" Foreground="{StaticResource BrushRed}" BorderBrush="{StaticResource BrushRed}" BorderThickness="1.5" FontSize="15" FontWeight="Bold" Height="45" Margin="0,0,0,10" Cursor="Hand" Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
