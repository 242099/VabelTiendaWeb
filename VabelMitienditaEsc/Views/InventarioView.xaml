<UserControl x:Class="VabelMitienditaEsc.Views.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:VabelMitienditaEsc.ViewModels"
             mc:Ignorable="d" 
             Background="{StaticResource BrushBackgroundWhite}"
             d:DesignHeight="720" d:DesignWidth="1080"
             d:DataContext="{d:DesignInstance {x:Type viewmodels:InventarioViewModel}}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="40,30,40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Inventario" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Pagina principal" FontSize="14" Foreground="#7F8C8D"/>
                </StackPanel>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderThickness="1" BorderBrush="#E5E8E8" CornerRadius="10" Margin="0,0,20,0" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource IconStyle}" Text="&#xe1a1;" Foreground="{StaticResource BrushPrimaryBlue}" FontSize="20" Margin="0,0,10,0"/>
                        <TextBlock Text="Total productos" FontSize="14" FontWeight="SemiBold" Foreground="#95A5A6" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalProductos}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" BorderThickness="1" BorderBrush="#E5E8E8" CornerRadius="12" Padding="20" Margin="10,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="40" Height="40" CornerRadius="8" Background="#E8F8F5" Margin="0,0,15,0">
                            <TextBlock Style="{StaticResource IconStyle}" Text="&#xe227;" Foreground="#27AE60" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Valor Total del Inventario" FontSize="14" FontWeight="SemiBold" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ValorTotalInventario, StringFormat={}{0:C}}" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Foreground="#2C3E50"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderThickness="1" BorderBrush="#E5E8E8" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Últimos productos añadidos" FontSize="14" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding UltimosProductos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{Binding Nombre}" FontSize="13" Foreground="#34495E"/>
                                    <TextBlock Text="  -  " Foreground="#BDC3C7"/>
                                    <TextBlock Text="{Binding StockActual}" Foreground="#7F8C8D"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Left" Width="300" Grid.ColumnSpan="3">
                <TextBlock Text="Opciones" FontSize="16" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,15"/>

                <Button Command="{Binding MostrarFormularioNuevoProductoCommand}" 
                        Background="White" BorderBrush="#E5E7E9" BorderThickness="1" 
                        Padding="15" Margin="0,0,0,10" Cursor="Hand" HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8F9F9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource IconStyle}" Text="&#xe3c9;" Foreground="{StaticResource BrushPrimaryBlue}" FontSize="24" Margin="0,0,15,0"/>
                        <TextBlock Grid.Column="1" Text="Agregar producto" FontSize="16" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource IconStyle}" Text="&#xe5cc;" Foreground="#BDC3C7" FontSize="20" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Button Command="{Binding VerDetalleProductoCommand}" 
                        Background="White" BorderBrush="#E5E7E9" BorderThickness="1" 
                        Padding="15" Margin="0,0,0,10" Cursor="Hand" HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8F9F9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource IconStyle}" Text="&#xe872;" Foreground="{StaticResource BrushRed}" FontSize="24" Margin="0,0,15,0"/>
                        <TextBlock Grid.Column="1" Text="Ver detalle de producto" FontSize="16" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource IconStyle}" Text="&#xe5cc;" Foreground="#BDC3C7" FontSize="20" VerticalAlignment="Center"/>
                    </Grid>
                </Button>


            </StackPanel>

            <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="25" Margin="20,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#000000" Opacity="0.04"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock  Grid.Column="0" HorizontalAlignment="Left" Text="Lista de Inventario" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}" TextWrapping="Wrap" Width="180"/>
                        </StackPanel>

                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" >
                            <ItemsControl ItemsSource="{Binding ListaInventario}" >
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderThickness="1" BorderBrush="#E5E8E8" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="IconBorder" Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="#EBF5FB" Margin="0,0,15,0">
                                                    <TextBlock x:Name="IconText" Style="{StaticResource IconStyle}" Text="&#xe8cb;" Foreground="{StaticResource BrushPrimaryBlue}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Código: " FontSize="13" Foreground="#95A5A6"/>
                                                        <TextBlock Text="{Binding Codigo}" FontSize="13" Foreground="#95A5A6" FontWeight="Medium" Margin="0,0,8,0"/>
                                                        <TextBlock Text="•" FontSize="13" Foreground="#BDC3C7" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Producto.CategoriaNombre}" FontSize="13" Foreground="#7F8C8D"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock x:Name="StockText" Text="{Binding Stock, StringFormat=Stock: {0}}" FontSize="14" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Precio, StringFormat={}{0:C}}" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <Button Command="{Binding DataContext.EditarProductoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand">
                                                            <TextBlock Style="{StaticResource IconStyle}" Text="&#xe5d2;" Foreground="#2C3E50" FontSize="20"/>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.EliminarProductoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand">
                                                            <TextBlock Style="{StaticResource IconStyle}" Text="&#xe872;" Foreground="{StaticResource BrushRed}" FontSize="18"/>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ScrollViewer Height="250" Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding MostrarFormularioAgregarProducto, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Grid.RowSpan="2">
                            <StackPanel Margin="10,20,10,20">

                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Registrar Nuevo Producto"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                    <Setter Property="Text" Value="Modificar Producto Existente"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="Nombre del Producto" FontSize="14" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding NuevoProductoNombre, UpdateSourceTrigger=PropertyChanged}" Padding="12" FontSize="14" BorderThickness="1" BorderBrush="#BDC3C7" Margin="0,0,0,15">
                                    <TextBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>

                                <TextBlock Text="Descripción" FontSize="14" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding NuevoProductoDescripcion, UpdateSourceTrigger=PropertyChanged}" Padding="12" FontSize="14" BorderThickness="1" BorderBrush="#BDC3C7" Margin="0,0,0,15" Height="60" TextWrapping="Wrap" AcceptsReturn="True">
                                    <TextBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Código de Barras" FontSize="14" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding NuevoProductoCodigo, UpdateSourceTrigger=PropertyChanged}" Padding="12" FontSize="14" BorderThickness="1" BorderBrush="#BDC3C7">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Marca" FontSize="14" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding NuevoProductoMarca, UpdateSourceTrigger=PropertyChanged}" Padding="12" FontSize="14" BorderThickness="1" BorderBrush="#BDC3C7">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Precio Compra ($)" FontSize="14" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding NuevoProductoPrecioCompra, UpdateSourceTrigger=PropertyChanged}" Padding="12" FontSize="14" BorderThickness="1" BorderBrush="#BDC3C7">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Precio Venta ($)" FontSize="14" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding NuevoProductoPrecio, UpdateSourceTrigger=PropertyChanged}" Padding="12" FontSize="14" BorderThickness="1" BorderBrush="#BDC3C7">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Stock Actual" FontSize="14" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding NuevoProductoStock, UpdateSourceTrigger=PropertyChanged}" Padding="12" FontSize="14" BorderThickness="1" BorderBrush="#BDC3C7">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Stock Mínimo (Alerta)" FontSize="14" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding NuevoProductoStockMinimo, UpdateSourceTrigger=PropertyChanged}" Padding="12" FontSize="14" BorderThickness="1" BorderBrush="#BDC3C7">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,25">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ubicación en Tienda" FontSize="14" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding NuevoProductoUbicacion, UpdateSourceTrigger=PropertyChanged}" Padding="12" FontSize="14" BorderThickness="1" BorderBrush="#BDC3C7">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ID Categoría (Número)" FontSize="14" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding NuevoProductoCategoriaId, UpdateSourceTrigger=PropertyChanged}" Padding="12" FontSize="14" BorderThickness="1" BorderBrush="#BDC3C7">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                                    <Button Command="{Binding CancelarAgregarProductoCommand}" 
                                            Background="#E5E7E9" 
                                            Foreground="#34495E" 
                                            Padding="20,10" 
                                            Margin="0,0,10,0" 
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        Cancelar
                                    </Button>

                                    <Button Padding="20,10">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{StaticResource BrushYellow}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Content" Value="Guardar producto"/>
                                                <Setter Property="Command" Value="{Binding RegistrarProductoCommand}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="0.85"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                        <Setter Property="Content" Value="Guardar cambios"/>
                                                        <Setter Property="Command" Value="{Binding ModificarProductoCommand}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>